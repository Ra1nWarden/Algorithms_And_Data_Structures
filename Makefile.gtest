# GoogleTest configuration
# This file downloads and builds GoogleTest from GitHub

GTEST_VERSION = 1.15.2
GTEST_DIR = googletest-$(GTEST_VERSION)
GTEST_URL = https://github.com/google/googletest/archive/refs/tags/v$(GTEST_VERSION).tar.gz
GTEST_ARCHIVE = googletest-$(GTEST_VERSION).tar.gz

# Compiler flags for gtest
CPPFLAGS += -isystem $(GTEST_DIR)/googletest/include

# GTEST_HEADERS should depend on the GTEST_DIR being present
# Individual Makefiles can use $(GTEST_DIR) as a dependency marker
GTEST_HEADERS = $(GTEST_DIR)

# Download and extract GoogleTest if not present
$(GTEST_DIR):
	@echo "Downloading GoogleTest $(GTEST_VERSION)..."
	@curl -L -o $(GTEST_ARCHIVE) $(GTEST_URL)
	@tar -xzf $(GTEST_ARCHIVE)
	@rm $(GTEST_ARCHIVE)
	@echo "GoogleTest downloaded and extracted successfully."

# Build gtest-all.o
gtest-all.o: $(GTEST_DIR)
	$(CXX) $(CPPFLAGS) -I$(GTEST_DIR)/googletest $(CXXFLAGS) -c \
		$(GTEST_DIR)/googletest/src/gtest-all.cc

# Build gtest_main.o
gtest_main.o: $(GTEST_DIR)
	$(CXX) $(CPPFLAGS) -I$(GTEST_DIR)/googletest $(CXXFLAGS) -c \
		$(GTEST_DIR)/googletest/src/gtest_main.cc

# Create gtest.a static library
gtest.a: gtest-all.o
	$(AR) $(ARFLAGS) $@ $^

# Create gtest_main.a static library
gtest_main.a: gtest-all.o gtest_main.o
	$(AR) $(ARFLAGS) $@ $^

# Clean target for gtest artifacts
clean-gtest:
	rm -f gtest.a gtest_main.a gtest-all.o gtest_main.o
	rm -rf $(GTEST_DIR)
